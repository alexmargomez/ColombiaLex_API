# ==============================================================================
# ALCONTABLE — Configuración Estándar de 3 Puertos para ALpanel
# ==============================================================================

# 1. Puertos del Proyecto (Sincronizados automáticamente por ALpanel)
FRONTEND_PORT=5176
BACKEND_PORT=8085
DB_EXTERNAL_PORT=3312

# 2. Dominio y CORS (ALpanel inyecta el dominio real al asignarlo en Dominios & SSL)
APP_DOMAIN=localhost
APP_URL=http://localhost:8085
CORS_ALLOWED_ORIGINS=*

# 3. Credenciales de Base de Datos (MariaDB 11 - Detectadas por Inspector SQL de ALpanel)
MARIADB_DATABASE=alcontable_db
MARIADB_USER=alcontable_user
MARIADB_PASSWORD=alcontable_pass_2026
MARIADB_ROOT_PASSWORD=alcontable_root_2026

DB_HOST=db
DB_PORT=3306

# 4. Variables Frontend (Vite Proxy hacia contenedor Backend)
VITE_API_URL=/api
VITE_BACKEND_PROXY=http://backend:8085
